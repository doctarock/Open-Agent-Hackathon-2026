# Evidence Desk configuration. Copy to .env (git-ignored) and fill in.
# Placeholders only: never commit real values.

# --- Evidence source --------------------------------------------------------
# fixture: local fixture files, labelled as fixtures everywhere.
# zetaris: live queries through a Zetaris Lightning platform. If they fail, the
#          app shows the error; it never falls back to fixtures.
EVIDENCE_MODE=fixture

# Zetaris (only read when EVIDENCE_MODE=zetaris, or by the zetaris:* scripts).
# For the local Docker Compose bundle the base URL is its web interface.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_USERNAME=<your-zetaris-login-email>
ZETARIS_PASSWORD=<your-zetaris-password>
# Optional: taken from the login response when unset.
ZETARIS_ORG_ID=
# Which tables hold which source system's evidence.
ZETARIS_QUERY_CONFIG=config/zetaris-queries.json
# Driver container for `npm run zetaris:seed` (local bundle only).
ZETARIS_DRIVER_CONTAINER=zetaris-driver-1

# --- Reasoning model --------------------------------------------------------
# rules:    deterministic fact rules from the scenario, no model.
# nemotron: NVIDIA Nemotron through an OpenAI-compatible chat endpoint.
REASONER=rules

# NVIDIA hosted API:   NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
#                      NEMOTRON_MODEL=<a Nemotron model id from build.nvidia.com>
# Local Ollama:        NEMOTRON_BASE_URL=http://127.0.0.1:11434/v1
#                      NEMOTRON_MODEL=<a local Nemotron tag, e.g. from `ollama list`>
NEMOTRON_BASE_URL=
NEMOTRON_MODEL=
# The NAME of the variable holding the API key (not needed for local Ollama).
NEMOTRON_API_KEY_ENV=NEMOTRON_API_KEY
NEMOTRON_API_KEY=<your-nvidia-api-key>
NEMOTRON_TIMEOUT_MS=180000
# Output budget per call. Nemotron's reasoning trace counts against it.
NEMOTRON_MAX_TOKENS=4096
# Sent as reasoning_effort when set. "none" turns the reasoning trace off on
# Ollama; leave empty for endpoints that do not accept the parameter.
NEMOTRON_REASONING_EFFORT=

# --- Execution (Meterless Markovian engine) ---------------------------------
MARKOVIAN_MAX_CHUNKS=8
EVIDENCE_BATCH_SIZE=2

# --- Storage and server -----------------------------------------------------
# Evidence Desk's own Speck database; `npm run db:reset` deletes it.
EVIDENCE_DESK_DATA_DIR=data
EVIDENCE_DESK_DB=evidence-desk.sqlite
EVIDENCE_DESK_HOST=127.0.0.1
EVIDENCE_DESK_PORT=4320
