# Evidence Desk configuration. `npm run configure` writes .env (git-ignored)
# for you, checking each choice; or copy this file to .env and fill it in.
# The standalone server, the scripts and the Speck plugin all read that one .env.
# Placeholders only: never commit real values.

# --- Evidence source --------------------------------------------------------
# fixture: local fixture files, labelled as fixtures everywhere.
# zetaris: live queries through a Zetaris Lightning platform. If they fail, the
#          app shows the error; it never falls back to fixtures.
EVIDENCE_MODE=fixture

# Zetaris (only read when EVIDENCE_MODE=zetaris, or by the zetaris:* scripts).
# For the local Docker Compose bundle the base URL is its web interface.
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_USERNAME=<your-zetaris-login-email>
ZETARIS_PASSWORD=<your-zetaris-password>
# Optional: taken from the login response when unset.
ZETARIS_ORG_ID=
# Which tables hold which source system's evidence.
ZETARIS_QUERY_CONFIG=config/zetaris-queries.json
# Driver container for `npm run zetaris:seed` (local bundle only).
ZETARIS_DRIVER_CONTAINER=zetaris-driver-1

# --- Reasoning model --------------------------------------------------------
# rules:    deterministic fact rules from the scenario, no model.
# nemotron: the model assessor, through the provider below.
REASONER=rules

# Evidence Desk's corroboration rule: corroborated-1 (Build 4, the default) or
# corroborated-2 (Build 5 candidate; docs/build-5-corroboration.md).
# CONCLUSION_RULE=corroborated-1

# meterless:         a Meterless Runtime, which routes each call (the default).
# ollama:            a Nemotron model on local Ollama.
# nvidia:            a Nemotron model on NVIDIA's hosted API.
# openai-compatible: any other endpoint serving Nemotron (NEMOTRON_BASE_URL).
MODEL_PROVIDER=meterless

# Meterless Runtime. Any pasted form of the address works (with or without
# http://, /v1, /v1/models, /healthz). The model is a routing mode from the
# runtime's /v1/models: meterless/auto, fast, deep, cheap, local, fusion, or
# meterless/<class>[.<disposition>]. The token is in <stateDir>/proxy-token.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_MODEL=meterless/auto
meterless_runtime_token=<the-runtime-proxy-token>

# Ollama and NVIDIA. The base URL defaults to the provider's own
# (http://127.0.0.1:11434/v1, https://integrate.api.nvidia.com/v1).
#   Ollama: NEMOTRON_MODEL=<a local Nemotron tag, e.g. from `ollama list`>,
#           NEMOTRON_REASONING_EFFORT=none
#   NVIDIA: NEMOTRON_MODEL=<a Nemotron model id from build.nvidia.com>
NEMOTRON_BASE_URL=
NEMOTRON_MODEL=
# The NAME of the setting holding the API key (not needed for local Ollama).
NEMOTRON_API_KEY_ENV=NEMOTRON_API_KEY
NEMOTRON_API_KEY=<your-nvidia-api-key>
NEMOTRON_TIMEOUT_MS=180000
# Output budget per call. Nemotron's reasoning trace counts against it.
NEMOTRON_MAX_TOKENS=4096
# Sent as reasoning_effort when set. "none" turns the reasoning trace off on
# Ollama; leave empty for endpoints that do not accept the parameter.
NEMOTRON_REASONING_EFFORT=
# Decisive mode's one stateless call. Unset or empty: "medium" (reasoning on) for Ollama
# and Meterless, the provider's default otherwise; "none" turns it off.
NEMOTRON_DECISIVE_REASONING_EFFORT=

# --- Execution (Meterless Markovian engine) ---------------------------------
MARKOVIAN_MAX_CHUNKS=8
EVIDENCE_BATCH_SIZE=2

# --- Storage and server -----------------------------------------------------
# Evidence Desk's own Speck database; `npm run db:reset` deletes it.
EVIDENCE_DESK_DATA_DIR=data
EVIDENCE_DESK_DB=evidence-desk.sqlite
EVIDENCE_DESK_HOST=127.0.0.1
EVIDENCE_DESK_PORT=4320
