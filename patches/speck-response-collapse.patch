+export function setResponseCollapsed(collapsed) {
+  $("#responseDock").classList.toggle("collapsed", collapsed);
+  $("#responseText").hidden = collapsed;
+  const toggle = $("#responseToggle");
+  toggle.setAttribute("aria-expanded", String(!collapsed));
+  toggle.textContent = collapsed ? "Expand" : "Minimise";
+}
+
+export function toggleSpeckResponse() {
+  setResponseCollapsed(!$("#responseDock").classList.contains("collapsed"));
+}
+
+// Wired here rather than in speck.js, which this project's home-view patch also changes.
+$("#responseToggle")?.addEventListener("click", toggleSpeckResponse);
