index 0000000..e2bb5ab
--- /dev/null
+++ b/src/speck/components/investigations.ts
@@ -0,0 +1,60 @@
+// Investigations recorded in Speck by the Evidence Desk plugin. Each case
+// publishes one shared memory with its current state (data.evidenceDeskSummary:
+// its conclusion, the records for and against it, what is ruled out and what
+// no longer counts), replaced whenever its beliefs change. When a message is
+// about an investigation, the answering model is shown the matching
+// summaries and told to answer from them only. A failure recalls nothing and
+// never fails the turn.
+
+import type { Component } from "../component.js";
+
+// A message is about an investigation when it says so, or names an
+// identifier a case summary contains (a case, order, parcel or invoice id).
+// Shared-memory recall alone ranks the nearest memory however unrelated, so
+// it is never enough on its own.
+const ABOUT_A_CASE = /\b(investigat\w*|dispute\w*|evidence)\b/i;
+const IDENTIFIER = /\b[A-Z]{2,}(?:-[A-Z0-9]+)*-\d+\b/g;
+const LIMIT = 4;
+
+interface InvestigationsRecord { recalled: string[] }
+
+export const investigations: Component = {
+  id: "investigations",
+  option: {
+    label: "Evidence Desk investigations",
+    description: "Answers questions about investigations from the cases' current state as Evidence Desk recorded it in Speck: their conclusions, the evidence for and against, and what no longer counts.",
+    cost: "under 0.1 s per message",
+    enabledByDefault: true
+  },
+
+  async contribute(context) {
+    const runtime = context.runtime;
+    if (!runtime) return null;
+    try {
+      const isSummary = (data: Record<string, unknown>) => Boolean(data.evidenceDeskSummary);
+      const current = runtime.mentalObjects.listAll()
+        .filter((object) => object.workerId === null && object.status !== "archived" && isSummary(object.data))
+        .sort((left, right) => right.createdAt.localeCompare(left.createdAt));
+      let summaries = current.filter((object) => [...new Set(object.content.match(IDENTIFIER) ?? [])].some((id) => context.message.includes(id)));
+      if (!summaries.length && ABOUT_A_CASE.test(context.message)) {
+        const recalled = (await runtime.retrieveSharedMemories({ query: context.message, limit: 8 }))
+          .map((entry) => entry.object).filter((object) => isSummary(object.data));
+        summaries = recalled.length ? recalled : current;
+      }
+      summaries = summaries.slice(0, LIMIT);
+      if (!summaries.length) return null;
+      const record: InvestigationsRecord = { recalled: summaries.map((object) => String((object.data.evidenceDeskSummary as { caseId?: unknown }).caseId ?? object.id)) };
+      context.scratch.set("investigations.record", record);
+      return [
+        "Investigations recorded in Speck by Evidence Desk, each as it currently stands (read from Speck's beliefs). Answer questions about these investigations only from these notes. Name the evidence by its record id and say what the record states. Do not add evidence, confirmations, signatures, dates or other details the notes do not state. If the notes do not answer the question, say so.",
+        ...summaries.map((object) => `---\n${object.content}`)
+      ].join("\n");
+    } catch {
+      return null;
+    }
+  },
+
+  record(context) {
+    return (context.scratch.get("investigations.record") as InvestigationsRecord | undefined) as unknown as Record<string, unknown> ?? {};
+  }
+};
