diff --git a/src/tests/investigations-component.test.ts b/src/tests/investigations-component.test.ts
new file mode 100644
index 0000000..6308e30
--- /dev/null
+++ b/src/tests/investigations-component.test.ts
@@ -0,0 +1,79 @@
+// The investigations component (Evidence Desk project patch): a question
+// about an investigation is answered from the cases' current summaries, as
+// Evidence Desk publishes them to shared memory; any other message is left
+// untouched, and an archived (outdated) summary is never shown.
+
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import test from "node:test";
+import type { TurnContext } from "../speck/component.js";
+import { investigations } from "../speck/components/investigations.js";
+import { emptyRuleLearning } from "../speck/rule-learning.js";
+import { SpeckRuntime } from "../runtime/speck-runtime.js";
+
+async function withRuntime(body: (runtime: SpeckRuntime) => Promise<void>): Promise<void> {
+  const directory = fs.mkdtempSync(path.join(os.tmpdir(), "speck-investigations-"));
+  const runtime = new SpeckRuntime({ databasePath: path.join(directory, "speck.sqlite") });
+  await runtime.initialize();
+  try {
+    await body(runtime);
+  } finally {
+    runtime.close();
+    fs.rmSync(directory, { recursive: true, force: true });
+  }
+}
+
+function turn(runtime: SpeckRuntime, message: string): TurnContext {
+  return {
+    session: { id: "test", turns: [], rules: emptyRuleLearning(), log: [] }, message, turn: 0, history: [],
+    registry: runtime.modelRegistry, runtime, readerProcessorId: "", chat: { baseUrl: "", model: "" } as TurnContext["chat"], scratch: new Map()
+  };
+}
+
+async function publish(runtime: SpeckRuntime, caseId: string, content: string) {
+  const worker = await runtime.createWorker(`Case ${caseId}`, [], {});
+  return runtime.recordSharedMemory({ type: "semantic", content, sourceWorkerId: worker.id, data: { evidenceDeskSummary: { caseId } } });
+}
+
+test("a question about an investigation gets the case's summary; other messages are untouched", async () => {
+  await withRuntime(async (runtime) => {
+    await publish(runtime, "DISPUTE-1042", "Evidence Desk investigation DISPUTE-1042. Order ORD-1042. Current conclusion: unresolved.");
+    await publish(runtime, "EVAL-PAY-01", "Evidence Desk investigation EVAL-PAY-01. Invoice INV-77. Current conclusion: supported, unpaid.");
+
+    // Named by an identifier the summary contains: only that case.
+    const named = turn(runtime, "What did the investigation for ORD-1042 conclude?");
+    const notes = await investigations.contribute!(named);
+    assert.match(notes ?? "", /DISPUTE-1042/);
+    assert.doesNotMatch(notes ?? "", /EVAL-PAY-01/);
+    assert.match(notes ?? "", /only from these notes/);
+    assert.deepEqual(investigations.record!(named), { recalled: ["DISPUTE-1042"] });
+
+    // Plainly about an investigation, naming none: the current summaries.
+    assert.match(await investigations.contribute!(turn(runtime, "Why did the investigation change its conclusion?")) ?? "", /Evidence Desk investigation/);
+
+    // Anything else is left to the plain model.
+    for (const message of ["What is the capital of France?", "Can you help me write a cover letter?", "My order of operations is wrong, help"]) {
+      const context = turn(runtime, message);
+      assert.equal(await investigations.contribute!(context), null, message);
+      assert.deepEqual(investigations.record!(context), {});
+    }
+  });
+});
+
+test("an archived summary is never shown, and a failure recalls nothing without failing the turn", async () => {
+  await withRuntime(async (runtime) => {
+    const old = await publish(runtime, "DISPUTE-1042", "Evidence Desk investigation DISPUTE-1042. Order ORD-1042. Current conclusion: leading, delivered.");
+    await runtime.archiveSharedMemory(old.id);
+    assert.equal(await investigations.contribute!(turn(runtime, "What did ORD-1042's investigation conclude?")), null);
+    await publish(runtime, "DISPUTE-1042", "Evidence Desk investigation DISPUTE-1042. Order ORD-1042. Current conclusion: supported, wrong address.");
+    const notes = await investigations.contribute!(turn(runtime, "What did ORD-1042's investigation conclude?"));
+    assert.match(notes ?? "", /wrong address/);
+    assert.doesNotMatch(notes ?? "", /leading, delivered/);
+
+    const broken = { ...turn(runtime, "What did ORD-1042's investigation conclude?"), runtime: { mentalObjects: { listAll: () => { throw new Error("store down"); } } } as unknown as SpeckRuntime };
+    assert.equal(await investigations.contribute!(broken), null);
+    assert.equal(await investigations.contribute!({ ...broken, runtime: undefined }), null);
+  });
+});
