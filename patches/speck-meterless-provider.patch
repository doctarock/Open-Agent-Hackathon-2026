index 0000000..5c0c3d7
--- /dev/null
+++ b/src/models/meterless.ts
@@ -0,0 +1,119 @@
+// Meterless Runtime (1.4, provider contract v4): an OpenAI-compatible
+// endpoint whose model ids are routing modes (meterless/auto, meterless/deep,
+// meterless/<class>.<disposition>, ...), not models. It also serves a model it
+// lists by name (nvidia/nemotron-3.5-bolt-e4b, local-runtime/...): a pinned
+// model, sent as the model id and answered by that model. The runtime writes its
+// token to <stateDir>/proxy-token; Speck keeps it in the secret store under
+// METERLESS_TOKEN_HANDLE and sends it on every call.
+
+export const METERLESS_PROVIDER = "meterless";
+export const METERLESS_NAME = "Meterless Runtime";
+export const METERLESS_DEFAULT_BASE_URL = "http://127.0.0.1:8088/v1";
+export const METERLESS_DEFAULT_MODEL = "meterless/auto";
+export const METERLESS_TOKEN_HANDLE = "meterless_runtime_token";
+// Sent as meterless-app: Speck's own calls, unless a caller names its app.
+export const METERLESS_APP_ID = "speck";
+// A model load can take minutes.
+export const METERLESS_TIMEOUT_MS = 180_000;
+const PLACEHOLDER_TOKEN = "rt-local";
+
+export const METERLESS_DISPOSITIONS = ["auto", "fast", "deep", "cheap", "local", "fusion"] as const;
+export const METERLESS_AUTO_DETECT_PORTS = [8088, 8090, 8787, 11434];
+export const METERLESS_AUTO_DETECT_HOSTS = ["127.0.0.1", "localhost", "[::1]"];
+
+// A pasted address, with or without a scheme, /v1, /v1/chat/completions,
+// /v1/models or /healthz, as <host>/v1. Never /v1/v1.
+export function normaliseMeterlessUrl(input: string): string {
+  const trimmed = String(input ?? "").trim();
+  if (!trimmed) return METERLESS_DEFAULT_BASE_URL;
+  const url = new URL(/^[a-z][a-z0-9+.-]*:\/\//i.test(trimmed) ? trimmed : `http://${trimmed}`);
+  return `${url.origin}/v1`;
+}
+
+// A connect link (http://<host>:<port>/connect#k=<key>): the base URL from its
+// origin, and the key. Null for anything else. Never log the result.
+export function parseMeterlessConnectLink(input: string): { baseUrl: string; token: string } | null {
+  let url: URL;
+  try { url = new URL(String(input ?? "").trim()); } catch { return null; }
+  if (!/^\/connect\/?$/.test(url.pathname)) return null;
+  const token = new URLSearchParams(url.hash.replace(/^#/, "")).get("k")?.trim();
+  return token ? { baseUrl: `${url.origin}/v1`, token } : null;
+}
+
+export function usableMeterlessToken(token: string | null | undefined): string {
+  const value = String(token ?? "").trim();
+  return value === PLACEHOLDER_TOKEN ? "" : value;
+}
+
+export const isMeterlessModel = (id: string) => /^meterless\/\S+$/.test(id);
+// A model the runtime lists by name (<provider>/<model>), not a routing mode.
+export const isMeterlessPinnedModel = (id: string) => /^[A-Za-z0-9][\w.-]*\/\S+$/.test(id) && !isMeterlessModel(id);
+// Either one is a model id a Meterless processor can send.
+export const isMeterlessTarget = (id: string) => isMeterlessModel(id) || isMeterlessPinnedModel(id);
+
+// What a routing id selects. Ids this version does not know are kept, never dropped.
+export function describeMeterlessModel(id: string): string {
+  if (isMeterlessPinnedModel(id)) return "pinned model";
+  const mode = id.replace(/^meterless\//, "");
+  const dispositions: readonly string[] = METERLESS_DISPOSITIONS;
+  if (dispositions.includes(mode)) return `${mode} routing`;
+  const [cls, disposition, ...rest] = mode.split(".");
+  if (!rest.length && disposition && dispositions.includes(disposition)) return `${cls} class, ${disposition} routing`;
+  if (!disposition && cls) return `${cls} class`;
+  return "routing mode";
+}
+
+export function meterlessHeaders(token: string, options: { app?: string; chat?: boolean } = {}): Record<string, string> {
+  return {
+    ...(token ? { authorization: `Bearer ${token}` } : {}),
+    "meterless-app": options.app ?? METERLESS_APP_ID,
+    ...(options.chat ? { "meterless-scope": "user" } : {})
+  };
+}
+
+export type MeterlessStatus = "online" | "unauthorized" | "offline";
+// models: its routing modes; pinned: the models it lists by name.
+export interface MeterlessProbe { status: MeterlessStatus; baseUrl: string; models: string[]; pinned: string[]; detail: string }
+
+// /healthz only proves the process is up; /v1/models decides. 401 or 403 is
+// unauthorized, 200 listing meterless ids is online, anything else offline.
+export async function probeMeterless(baseUrl: string, token: string, options: { app?: string; timeoutMs?: number } = {}): Promise<MeterlessProbe> {
+  let base: string;
+  try { base = normaliseMeterlessUrl(baseUrl); } catch { return { status: "offline", baseUrl: String(baseUrl), models: [], pinned: [], detail: "not a valid address" }; }
+  let response: Response;
+  try {
+    response = await fetch(`${base}/models`, {
+      headers: meterlessHeaders(usableMeterlessToken(token), { ...(options.app ? { app: options.app } : {}) }),
+      signal: AbortSignal.timeout(options.timeoutMs ?? 3000)
+    });
+  } catch (error) {
+    return { status: "offline", baseUrl: base, models: [], pinned: [], detail: error instanceof Error ? error.message : String(error) };
+  }
+  if (response.status === 401 || response.status === 403) return { status: "unauthorized", baseUrl: base, models: [], pinned: [], detail: `HTTP ${response.status}` };
+  if (response.status !== 200) return { status: "offline", baseUrl: base, models: [], pinned: [], detail: `HTTP ${response.status}` };
+  const body = await response.json().catch(() => null) as { data?: Array<{ id?: unknown }> } | null;
+  const ids = (body?.data ?? []).flatMap((model) => (typeof model.id === "string" ? [model.id] : []));
+  const models = ids.filter(isMeterlessModel);
+  const pinned = ids.filter(isMeterlessPinnedModel);
+  return models.length
+    ? { status: "online", baseUrl: base, models, pinned, detail: `${models.length} routing mode(s)` }
+    : { status: "offline", baseUrl: base, models: [], pinned: [], detail: "answered, but lists no meterless/* models (another server on this port)" };
+}
+
+// Tries each port on each host; the first online or unauthorized one, in
+// that order, or null.
+export async function autoDetectMeterless(token: string, options: { app?: string; candidates?: string[] } = {}): Promise<MeterlessProbe | null> {
+  const candidates = options.candidates
+    ?? METERLESS_AUTO_DETECT_PORTS.flatMap((port) => METERLESS_AUTO_DETECT_HOSTS.map((host) => `http://${host}:${port}/v1`));
+  const results = await Promise.all(candidates.map((candidate) => probeMeterless(candidate, token, { ...(options.app ? { app: options.app } : {}), timeoutMs: 1500 })));
+  return results.find((result) => result.status !== "offline") ?? null;
+}
+
+// Where Speck's Meterless processors get the token: the host sets it to its
+// secret store; until then (and in tests) the meterless_runtime_token variable.
+let tokenSource: () => Promise<string | null> = async () => process.env[METERLESS_TOKEN_HANDLE] ?? null;
+export function setMeterlessTokenSource(source: () => Promise<string | null>): void { tokenSource = source; }
+export async function meterlessToken(): Promise<string> {
+  const stored = usableMeterlessToken(await tokenSource().catch(() => null));
+  return stored || usableMeterlessToken(process.env[METERLESS_TOKEN_HANDLE]);
+}
