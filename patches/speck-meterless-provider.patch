@@ -0,0 +1,116 @@
+// The Meterless Runtime provider (Evidence Desk project patch): provider
+// contract v4 against a stand-in runtime that checks the token on every call.
+
+import assert from "node:assert/strict";
+import http from "node:http";
+import test from "node:test";
+import { validateModelProcessors } from "../config.js";
+import { autoDetectMeterless, describeMeterlessModel, normaliseMeterlessUrl, parseMeterlessConnectLink, probeMeterless, setMeterlessTokenSource } from "../models/meterless.js";
+import { createConfiguredProcessor, MeterlessProcessor } from "../models/providers.js";
+import { chat } from "../speck/chat.js";
+
+const TOKEN = "stand-in-token-not-a-secret";
+
+async function standIn(models = ["meterless/auto", "meterless/deep", "meterless/reasoning.fast", "meterless/new-mode"]) {
+  const seen: Array<{ path: string; headers: http.IncomingHttpHeaders; body: any }> = [];
+  const server = http.createServer((request, response) => {
+    let body = "";
+    request.on("data", (chunk) => { body += chunk; });
+    request.on("end", () => {
+      seen.push({ path: request.url ?? "", headers: request.headers, body: body ? JSON.parse(body) : null });
+      const send = (status: number, value: unknown) => { response.writeHead(status, { "content-type": "application/json" }); response.end(JSON.stringify(value)); };
+      if (request.url === "/healthz") return send(200, { ok: true });
+      if (request.headers.authorization !== `Bearer ${TOKEN}`) return send(401, { error: "unauthorized" });
+      if (request.url === "/v1/models") return send(200, { data: models.map((id) => ({ id })) });
+      if (request.url === "/v1/chat/completions") return send(200, { model: "routed", choices: [{ message: { role: "assistant", content: "ready" } }], usage: { prompt_tokens: 3, completion_tokens: 1 } });
+      send(404, {});
+    });
+  }).listen(0, "127.0.0.1");
+  await new Promise((resolve) => server.once("listening", resolve));
+  const { port } = server.address() as { port: number };
+  return { url: `http://127.0.0.1:${port}`, seen, close: () => server.close() };
+}
+
+test("a pasted address becomes <host>/v1, never /v1/v1; a connect link gives the address and the key", () => {
+  for (const pasted of ["127.0.0.1:8088", "http://127.0.0.1:8088/", "http://127.0.0.1:8088/v1", "http://127.0.0.1:8088/v1/chat/completions", "http://127.0.0.1:8088/v1/models", "http://127.0.0.1:8088/healthz"]) {
+    assert.equal(normaliseMeterlessUrl(pasted), "http://127.0.0.1:8088/v1", pasted);
+  }
+  assert.deepEqual(parseMeterlessConnectLink("http://10.0.0.5:8090/connect#k=abc"), { baseUrl: "http://10.0.0.5:8090/v1", token: "abc" });
+  assert.equal(parseMeterlessConnectLink("http://10.0.0.5:8090/v1"), null);
+  assert.equal(describeMeterlessModel("meterless/reasoning.fast"), "reasoning class, fast routing");
+});
+
+test("a Meterless processor is validated as a routing mode at <host>/v1", () => {
+  const [processor] = validateModelProcessors([{ id: "meterless", provider: "meterless", model: "meterless/auto", baseUrl: "127.0.0.1:8088/v1/models", tier: 2, contextSize: 32768 }]);
+  assert.equal(processor!.baseUrl, "http://127.0.0.1:8088/v1");
+  assert.ok(createConfiguredProcessor(processor!) instanceof MeterlessProcessor);
+  assert.throws(() => validateModelProcessors([{ id: "m", provider: "meterless", model: "qwen3:14b", baseUrl: "http://127.0.0.1:8088", tier: 2, contextSize: 32768 }]), /routing mode/);
+});
+
+test("a model the runtime lists by name is a pinned model: accepted, and listed apart from the routing modes", async () => {
+  const [processor] = validateModelProcessors([{ id: "bolt", provider: "meterless", model: "nvidia/nemotron-3.5-bolt-e4b", baseUrl: "127.0.0.1:8088", tier: 2, contextSize: 32768 }]);
+  assert.equal(processor!.model, "nvidia/nemotron-3.5-bolt-e4b");
+  assert.equal(describeMeterlessModel("local-runtime/nemotron-3.5-bolt-e4b"), "pinned model");
+  assert.throws(() => validateModelProcessors([{ id: "m", provider: "meterless", model: "qwen3:14b", baseUrl: "http://127.0.0.1:8088", tier: 2, contextSize: 32768 }]), /<provider>\/<model>/);
+  const runtime = await standIn(["meterless/auto", "nvidia/nemotron-3.5-bolt-e4b", "local-runtime/gemma-4-e4b-it"]);
+  const ollama = await standIn(["hf.co/bartowski/model:Q4_K_M"]);
+  try {
+    const probe = await probeMeterless(runtime.url, TOKEN);
+    assert.deepEqual([probe.status, probe.models, probe.pinned], ["online", ["meterless/auto"], ["nvidia/nemotron-3.5-bolt-e4b", "local-runtime/gemma-4-e4b-it"]]);
+    assert.equal((await probeMeterless(ollama.url, TOKEN)).status, "offline", "named models alone do not make a server a Meterless Runtime");
+  } finally {
+    runtime.close();
+    ollama.close();
+  }
+});
+
+test("a wrong token is unauthorized, not offline; Auto Detect finds the runtime and skips other servers", async () => {
+  const runtime = await standIn();
+  const other = await standIn(["llama3.1:8b"]);
+  try {
+    assert.equal((await probeMeterless(runtime.url, "wrong")).status, "unauthorized");
+    assert.equal((await probeMeterless(`${runtime.url}/healthz`, TOKEN)).status, "online");
+    assert.equal((await probeMeterless(other.url, TOKEN)).status, "offline");
+    const found = await autoDetectMeterless(TOKEN, { candidates: ["http://127.0.0.1:9/v1", `${other.url}/v1`, `${runtime.url}/v1`] });
+    assert.deepEqual([found?.status, found?.baseUrl], ["online", `${runtime.url}/v1`]);
+    assert.deepEqual(found?.models, ["meterless/auto", "meterless/deep", "meterless/reasoning.fast", "meterless/new-mode"], "unknown meterless ids are kept");
+  } finally {
+    runtime.close();
+    other.close();
+  }
+});
+
+test("a plain text request on meterless/auto returns a string, with the stored token, meterless-app and meterless-scope", async () => {
+  const runtime = await standIn();
+  setMeterlessTokenSource(async () => TOKEN);
+  try {
+    const processor = createConfiguredProcessor({ id: "meterless", provider: "meterless", model: "meterless/auto", baseUrl: `${runtime.url}/v1/chat/completions`, tier: 2, contextSize: 32768, specialties: ["general"], enabled: true });
+    const completion = await processor.infer({ prompt: "Reply with the single word: ready", temperature: 0, timeoutMs: 1000 });
+    assert.equal(completion.text, "ready");
+    const chat = runtime.seen.find((call) => call.path === "/v1/chat/completions")!;
+    assert.equal(chat.headers.authorization, `Bearer ${TOKEN}`);
+    assert.equal(chat.headers["meterless-app"], "speck");
+    assert.equal(chat.headers["meterless-scope"], "user");
+    assert.equal(typeof chat.body.messages.at(-1).content, "string");
+    setMeterlessTokenSource(async () => "wrong");
+    await assert.rejects(processor.infer({ prompt: "x", temperature: 0, timeoutMs: 1000 }), /HTTP 401/);
+  } finally {
+    setMeterlessTokenSource(async () => null);
+    runtime.close();
+  }
+});
+
+test("Speck's chat path answers through a Meterless Runtime when the worker is one", async () => {
+  const runtime = await standIn();
+  setMeterlessTokenSource(async () => TOKEN);
+  try {
+    const settings = { provider: "meterless" as const, baseUrl: runtime.url, model: "meterless/deep", temperature: 0.2, contextSize: 16_384, outputBudget: 512, timeoutMs: 1000 };
+    const answered = await chat(settings, [{ role: "user", content: "Hello" }]);
+    assert.equal(answered.reply, "ready");
+    const call = runtime.seen.find((entry) => entry.path === "/v1/chat/completions")!;
+    assert.deepEqual([call.body.model, call.body.messages[0].content, call.headers["meterless-scope"], call.headers["meterless-app"]], ["meterless/deep", "Hello", "user", "speck"]);
+  } finally {
+    setMeterlessTokenSource(async () => null);
+    runtime.close();
+  }
+});
