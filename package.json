{
  "name": "evidence-desk",
  "version": "0.1.0",
  "private": true,
  "description": "Speck Evidence Desk: investigating conflicting, changing evidence with persistent cognition",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#speck": "./speck/dist/index.js"
  },
  "scripts": {
    "setup": "git submodule update --init --recursive && npm ci && npm --prefix speck ci && npm run speck:patch && npm --prefix speck run build && npm run plugin:install && node dist/src/scripts/configure.js --first-run",
    "configure": "npm run build && node dist/src/scripts/configure.js",
    "speck:patch": "node scripts/speck-patches.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "npm run build && node --watch-path=dist dist/src/server.js",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/test/**/*.test.js\"",
    "db:reset": "npm run build && node dist/src/scripts/reset-db.js",
    "zetaris:seed": "npm run build && node dist/src/scripts/zetaris-seed.js",
    "zetaris:check": "npm run build && node dist/src/scripts/zetaris-check.js",
    "zetaris:usl": "npm run build && node dist/src/scripts/zetaris-usl.js",
    "model:check": "npm run build && node dist/src/scripts/model-check.js",
    "eval": "npm run build && node dist/src/scripts/eval.js",
    "eval:live": "npm run build && node dist/src/scripts/eval.js --live",
    "eval:reasoning": "npm run build && node dist/src/scripts/eval-reasoning.js",
    "eval:cross-domain": "npm run build && node dist/src/scripts/eval-cross-domain.js",
    "compare": "npm run build && node dist/src/scripts/compare.js",
    "compare:live": "npm run build && node dist/src/scripts/compare.js --live",
    "sponsors:verify": "npm run build && node dist/src/scripts/sponsor-check.js",
    "plugin:install": "npm run build && node dist/src/scripts/plugin-install.js",
    "speck": "node dist/src/scripts/speck.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.9.3"
  }
}
